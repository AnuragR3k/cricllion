# Hosted Postgres connection string (Neon pooled URL recommended).
# Leave unset for local development, which uses .data/cricllion.db (SQLite).
DATABASE_URL=

# Secret used to sign answer receipts. Must be identical across all serverless
# instances. Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RECEIPT_SECRET=
